// Example demonstrating Rule B: Shared Objects
// Multiple objects sharing the same resource

class Texture {
public:
    string filename;
    int width;
    int height;
    
    Texture(string file) {
        filename = file;
        width = 1024;
        height = 768;
        std::cout << "Loading texture: " + filename << std::endl;
    }
};

class Material {
public:
    Texture diffuseTexture;    // Shared between multiple materials
    Texture normalTexture;     // Shared between multiple materials
    float shininess;
    
    Material(Texture diffuse, Texture normal, float shine) {
        diffuseTexture = diffuse;     // Sharing the texture
        normalTexture = normal;       // Sharing the texture
        shininess = shine;
    }
};

class Mesh {
public:
    Material material;         // Multiple meshes can share same material
    int vertexCount;
    
    Mesh(Material mat, int vertices) {
        material = mat;           // Sharing the material
        vertexCount = vertices;
    }
    
    void render() {
        std::cout << "Rendering mesh with " + vertexCount + " vertices" << std::endl;
        std::cout << "Using texture: " + material.diffuseTexture.filename << std::endl;
    }
};

int main() {
    // Create shared textures
    Texture rockTexture = new Texture("rock_diffuse.png");
    Texture rockNormal = new Texture("rock_normal.png");
    Texture metalTexture = new Texture("metal_diffuse.png");
    Texture metalNormal = new Texture("metal_normal.png");
    
    // Create materials that share textures
    Material rockMaterial = new Material(rockTexture, rockNormal, 0.2);
    Material metalMaterial = new Material(metalTexture, metalNormal, 0.8);
    
    // Create meshes that share materials
    Mesh wall1 = new Mesh(rockMaterial, 1000);      // Shares rock material
    Mesh wall2 = new Mesh(rockMaterial, 1200);      // Shares rock material
    Mesh pillar1 = new Mesh(metalMaterial, 800);    // Shares metal material
    Mesh pillar2 = new Mesh(metalMaterial, 800);    // Shares metal material
    
    // Render all meshes
    wall1.render();
    wall2.render();
    pillar1.render();
    pillar2.render();
    
    return 0;
}
