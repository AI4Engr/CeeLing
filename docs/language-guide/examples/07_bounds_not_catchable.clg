int main() {
    std::vector<int> v;
    v.push_back(1);
    int i = 4;
    try {
        std::cout << v[i] << std::endl;
    } catch (string e) {
        std::cout << "caught " << e << std::endl;
    }
    std::cout << "carried on" << std::endl;
    return 0;
}
