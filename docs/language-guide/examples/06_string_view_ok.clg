//@ expect: accept
//@ run: 5 3 8
int count(string_view v) {
    return v.size();
}

int main() {
    string s = "hello";
    string_view v = s;                    // a view of the local string s
    string_view w = v.substr(1, 3);       // a view of the same string
    std::cout << v.size() << " " << w.size() << " " << count(s) + count("lit") << std::endl;
    return 0;
}
