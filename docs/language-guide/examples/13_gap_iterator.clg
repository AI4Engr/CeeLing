int main() {
    std::vector<int> v;
    v.push_back(1);
    auto it = v.begin();               // an iterator into v
    v.push_back(2);                    // may move the storage: it now dangles
    std::cout << *it << std::endl;     // accepted today: iterators are not tracked
    return 0;
}
