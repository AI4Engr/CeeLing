//@ expect: reject
//@ error: cannot tell what the `string_view`
//@ generated: std::string_view sv = make();
string make() {
    return "a string long enough to live on the heap, not in the string object";
}

int main() {
    std::string_view sv = make();   // the string returned by make() is a temporary
    std::cout << sv << std::endl;   // refused before it can be written
    return 0;
}
