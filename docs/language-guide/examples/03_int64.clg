//@ expect: accept
//@ run: 10000000000 2500000000 4294967296
int main() {
    int64 big = 5000000000;           // does not fit in an int
    int64 doubled = big * 2;
    int64 halved = big >> 1;
    int64 square = int64(65536) * int64(65536);
    std::cout << doubled << " " << halved << " " << square << std::endl;
    return 0;
}
