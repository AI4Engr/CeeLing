//@ expect: accept
//@ run: 7 7 3
int main() {
    std::vector<int> v;
    v.push_back(7);
    v.push_back(8);
    v.push_back(3);
    v.reserve(100);                 // capacity only: size and values stay
    v.copyWithin(1, 0, 1);          // v[1] = v[0], inside the same vector
    std::cout << v[0] << " " << v[1] << " " << v[2] << std::endl;
    return 0;
}
