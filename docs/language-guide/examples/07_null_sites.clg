class Node {
public:
    int v;
    Node next;
    Node(int x) { v = x; }
    int value() { return v; }
};

int main() {
    std::vector<Node> row;
    row.push_back(new Node(1));
    Node first = row[0];
    std::cout << first.v << std::endl;
    std::cout << first.value() << std::endl;
    std::cout << row[0].v << std::endl;
    return 0;
}
