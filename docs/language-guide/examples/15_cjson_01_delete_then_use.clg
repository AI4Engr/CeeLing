class Item {
public:
    int valueint;
    Item(int v) { valueint = v; }
};

void deleteItem(Item item) {
}

int main() {
    Item item = new Item(7);
    deleteItem(item);
    std::cout << item.valueint << std::endl;
    return 0;
}
