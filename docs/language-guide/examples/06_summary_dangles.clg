//@ expect: reject
//@ error: use of dangling observer `r` (its owner `x` is gone)
class Node {
public:
    int v;
    Node(int x) { v = x; }
};

Node pick(Node a, Node b) {
    return a;
}

int main() {
    Node x = new Node(1);
    Node y = new Node(2);
    Node r = pick(x, y);    // r follows x
    x = new Node(3);        // x lets go of the object r follows
    std::cout << r.v << std::endl;
    return 0;
}
