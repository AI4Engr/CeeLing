//@ expect: accept
//@ run: 2 25 65
int main() {
    std::vector<int> v;
    v.push_back(10);
    v.push_back(20);
    v.push_back(30);
    v[1] = 25;
    int total = 0;
    for (int x : v) {
        total = total + x;
    }
    v.pop_back();
    std::cout << v.size() << " " << v[1] << " " << total << std::endl;
    return 0;
}
