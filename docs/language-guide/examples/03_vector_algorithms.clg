//@ expect: accept
//@ run: 1 2 5 9 | 9 5 2 1 | 2 -1 | 1 0
int main() {
    std::vector<int> v;
    v.push_back(5);
    v.push_back(2);
    v.push_back(9);
    v.push_back(1);
    v.sort();                              // no iterators, no comparator: the whole vector, ascending
    std::cout << v[0] << " " << v[1] << " " << v[2] << " " << v[3] << " | ";
    v.reverse();
    std::cout << v[0] << " " << v[1] << " " << v[2] << " " << v[3] << " | ";
    std::cout << v.indexOf(2) << " " << v.indexOf(7) << " | " << v.contains(9) << " " << v.contains(4) << std::endl;
    return 0;
}
