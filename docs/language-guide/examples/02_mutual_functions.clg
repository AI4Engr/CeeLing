//@ expect: accept
//@ run: 1 0
class Parity {
public:
    Parity() { }
    int isEven(int n) {
        if (n == 0) { return 1; }
        return isOdd(n - 1);               // a method may call one declared after it
    }
    int isOdd(int n) {
        if (n == 0) { return 0; }
        return isEven(n - 1);
    }
};

int main() {
    Parity p = new Parity();
    std::cout << p.isEven(10) << " " << p.isOdd(10) << std::endl;
    return 0;
}
