//@ expect: accept
//@ run: hi!
//@ run: hi
//@ run: hi
//@ generated: void shout(std::string s) {
//@ generated: void show(const std::string& s) {
void shout(string s) {
    s = s + "!";
    std::cout << s << std::endl;
}

void show(string s) {
    std::cout << s << std::endl;
}

int main() {
    string t = "hi";
    shout(t);           // a string is a value: the callee gets a copy, t stays usable
    show(t);            // read only: passed by const reference, not copied at all
    std::cout << t << std::endl;
    return 0;
}
