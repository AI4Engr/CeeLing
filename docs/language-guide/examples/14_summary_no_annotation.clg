//@ expect: accept
//@ run: 2
// No annotation says that "second" returns its second parameter. The compiler reads the body.
class Node {
public:
    int v;
    Node(int x) { v = x; }
};

Node second(Node a, Node b) {
    return b;
}

int main() {
    Node x = new Node(1);
    Node y = new Node(2);
    Node r = second(x, y);
    std::cout << r.v << std::endl;
    return 0;
}
