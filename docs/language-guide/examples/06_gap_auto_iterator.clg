//@ expect: reject
//@ error: `begin` is not available on `std::vector<int>`
std::vector<int> make() {
    std::vector<int> v;
    v.push_back(1);
    return v;
}

int main() {
    std::vector<int> v = make();
    auto it = v.begin();            // refused here: begin() returns an iterator, and iterators are not tracked
    v.push_back(2);
    std::cout << *it << std::endl;
    return 0;
}
