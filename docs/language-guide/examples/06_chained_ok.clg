//@ expect: accept
//@ run: 7
class Inner {
public:
    int v;
    Inner(int val) { v = val; }
};

class Holder {
public:
    Inner inner;
    Holder(int val) { inner = new Inner(val); }
    Inner getInner() { return inner; }
};

Holder makeHolder() {
    return new Holder(7);
}

int main() {
    Inner i = makeHolder().getInner();      // the first call's result is a temporary; the second call still works
    std::cout << i.v << std::endl;
    return 0;
}
