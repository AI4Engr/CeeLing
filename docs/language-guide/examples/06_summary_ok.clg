//@ expect: accept
//@ run: 1
class Node {
public:
    int v;
    Node(int x) { v = x; }
};

Node pick(Node a, Node b) {
    return a;               // summary of pick: the result is its first parameter
}

int main() {
    Node x = new Node(1);
    Node y = new Node(2);
    Node r = pick(x, y);    // so r refers to the object x referred to
    std::cout << r.v << std::endl;
    return 0;
}
