//@ expect: accept
//@ flags: --no-bounds-checks --no-null-checks
//@ generated: std::cout << v[n] << a->value() << std::endl;
class Node {
public:
    int v;
    Node(int x) { v = x; }
    int value() { return v; }
};

int main() {
    std::vector<int> v;
    v.push_back(1);
    int n = v.size() - 1;
    Node a = new Node(5);
    std::cout << v[n] << a.value() << std::endl;
    return 0;
}
