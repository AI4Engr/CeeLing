//@ expect: accept
//@ run: 123
class Job { public: Job() { } virtual void run() { } };

int main() {
    cling::setWorkerLimit(1);
    int one = 1;
    int two = 2;
    int three = 3;
    spawn(closure Job [one] () {
        std::cout << one;
    });
    spawn(closure Job [two] () {
        std::cout << two;
    });
    spawn(closure Job [three] () {
        std::cout << three;
    });
    return 0;
}
