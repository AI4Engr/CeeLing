//@ expect: reject
//@ error: use of moved-from value `a`
class Node {
public:
    int v;
    Node(int x) { v = x; }
};

void sink(Node n) { }

int main() {
    Node a = new Node(1);
    int i = 0;
    while (i < 3) {
        i = i + 1;
        if (i == 2) {
            sink(a);
            break;                         // leaves the loop with a moved
        }
    }
    std::cout << a.v << std::endl;         // after the loop, a may or may not have been moved
    return 0;
}
