//@ expect: reject
//@ error: use of dangling observer `n`
class Node {
public:
    int v;
    Node(int x) { v = x; }
};

int main() {
    std::vector<Node> v;
    v.push_back(new Node(1));
    ref Node n = v[0];
    v.push_back(new Node(2));     // may move the elements to new memory
    std::cout << n.v << std::endl;
    return 0;
}
