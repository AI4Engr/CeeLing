//@ expect: accept
//@ run: area of 3 x 4 = 12
//@ run: greeting: hello, CeeLing
#include <iostream>

int area(int width, int height) {
    return width * height;
}

string greet(string name) {
    return "hello, " + name;
}

int main() {
    int w = 3;
    int h = 4;
    std::cout << "area of " << w << " x " << h << " = " << area(w, h) << std::endl;
    std::cout << "greeting: " << greet("CeeLing") << std::endl;
    return 0;
}
