//@ expect: accept
//@ run: 3 1 -7 2 3.5
//@ run: 1010
//@ run: 12 3 5 8 -9
//@ run: 40 5
int main() {
    int a = 7;
    int b = 2;
    std::cout << a / b << " " << a % b << " " << -a << " " << a - 5 << " " << a / 2.0 << std::endl;
    std::cout << (a > b) << (a == b) << (a != b && !(a < b)) << (a <= b || a < 0) << std::endl;
    int bits = 12;
    std::cout << (bits & 4) + 8 << " " << (bits | 3) - 12 << " " << (bits >> 1) - 1 << " " << (1 << 3) << " " << ~8 << std::endl;
    std::cout << (5 << 3) << " " << (40 >> 3) << std::endl;
    return 0;
}
