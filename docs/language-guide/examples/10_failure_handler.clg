//@ expect: accept
//@ run: failed: boom 7
class Job { public: Job() { } virtual void run() { } };

class Failure {
public:
    Failure() { }
    virtual void fail(string message) { }
};

int main() {
    int id = 7;
    spawn(closure Job [id] () {
        throw "boom";
    }, closure Failure [id] (string message) {
        std::cout << "failed: " << message << " " << id << std::endl;
    });
    return 0;
}
