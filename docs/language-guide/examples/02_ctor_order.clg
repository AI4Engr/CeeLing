//@ expect: accept
//@ run: xy
//@ generated: Pair::Pair() : a("x") {
class Pair {
public:
    string b;                  // declared first ...
    string a;
    Pair() {
        a = "x";               // ... but assigned second
        b = a + "y";
    }
};

int main() {
    Pair p = new Pair();
    std::cout << p.b << std::endl;
    return 0;
}
