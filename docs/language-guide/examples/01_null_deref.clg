//@ expect: accept
//@ run-fail: cling: null dereference at line 11
class Node {
public:
    Node next;
    int v;
    Node(int x) { v = x; }
};

int main() {
    Node n = new Node(1);
    std::cout << n.v << std::endl;
    std::cout << n.next.v << std::endl;     // the last node has no next
    return 0;
}
