//@ expect: accept
//@ run: 1 1 8 0
//@ generated: int bare = ((4 >> 1) == 2);
int main() {
    int bare = 4 >> 1 == 2;          // as in C++: (4 >> 1) == 2, which is 1
    int grouped = (4 >> 1) == 2;
    int sum = 1 << 2 + 1;            // + binds tighter than <<: 1 << 3
    int masked = 6 & 3 == 3;         // == binds tighter than &, as in C++: 6 & (3 == 3) is 6 & 1
    std::cout << bare << " " << grouped << " " << sum << " " << masked << std::endl;
    return 0;
}
