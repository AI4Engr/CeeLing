//@ expect: accept
//@ run: 3
//@ generated: this->data = std::move(bytes);
class Holder {
public:
    std::vector<int> data;
    Holder() { }
    void take(std::vector<int> bytes) {
        data = bytes;                      // the last use of bytes: moved, not copied
    }
    int sum() {
        int total = 0;
        int i = 0;
        while (i < data.size()) {
            total = total + data[i];
            i = i + 1;
        }
        return total;
    }
};

int main() {
    Holder h = new Holder();
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    h.take(v);
    std::cout << h.sum() << std::endl;
    return 0;
}
