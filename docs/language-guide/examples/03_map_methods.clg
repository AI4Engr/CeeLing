//@ expect: accept
//@ run: 1 0 1 1
int main() {
    std::map<string, int> stock;
    stock["apple"] = 3;
    stock["pear"] = 0;
    int removed = stock.erase("apple");
    std::cout << removed << " " << stock.count("apple") << " " << stock.count("pear") << " " << stock.size() << std::endl;
    return 0;
}
