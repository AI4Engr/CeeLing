//@ expect: reject
//@ reason: found during design review of Chapter 18 Step 37 (this-as-argument
//@ reason: support), before any implementation: passing `this` from inside a
//@ reason: constructor is a GUARANTEED runtime crash, not a sometimes-risk.
//@ reason: `this` lowers to shared_from_this(), which throws
//@ reason: std::bad_weak_ptr unconditionally when called before the object's
//@ reason: shared_ptr control block exists -- and inside a constructor, it
//@ reason: never does yet (make_shared hasn't finished constructing). Per
//@ reason: the design notes' "default-reject, never default-allow", this is a hard
//@ reason: compile-time rejection (EscapeHatchChecker::
//@ reason: rejectThisEscapeInConstructor), mirroring the existing
//@ reason: virtual-call-from-constructor check's same inConstructor_-gated
//@ reason: posture for its own guaranteed-wrong-behavior case.

class Registry {
public:
    Registry() { }
    void addSelf(Registry r) { }
};

class Node {
public:
    Node() {
        Registry reg = new Registry();
        reg.addSelf(this);
    }
};

int main() {
    Node n = new Node();
    return 0;
}
