//@ expect: reject
//@ error: use of moved-from value `v`
//@ reason: `total(v)` is an argument of another call; it still moves v, so the later v.size() is a use after move.

int total(std::vector<int> v) {
    v.push_back(1);
    return v.size();
}

int twice(int x) {
    return x + x;
}

int main() {
    std::vector<int> v;
    v.push_back(5);
    int a = twice(total(v));
    std::cout << a << v.size() << std::endl;
    return 0;
}
