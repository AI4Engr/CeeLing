//@ expect: reject
//@ reason: `ref c = make()` observes a temporary that is destroyed at the end of the
//@ reason: declaration -- no field involved at all; the probe read freed memory.

class Item {
public:
    int v;
    Item(int x) { v = x; }
};

Item make() {
    return new Item(9);
}

int main() {
    ref Item c = make();
    std::cout << c.v << std::endl;
    return 0;
}
