ext_fn int sumFirstTwo(std::vector<byte> data);

int main() {
    std::vector<byte> data;
    data.push_back(10);
    data.push_back(20);
    int result = sumFirstTwo(data);
    std::cout << result << std::endl;
    return 0;
}
