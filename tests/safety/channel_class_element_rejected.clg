//@ expect: reject
//@ reason: A Channel carries what a spawn may capture -- plain values copied through the queue. An object (a class instance) may have other owners and may be a subclass declared elsewhere, so it is refused; send a struct or serialize it.

class Thing {
public:
    int n;
    Thing(int k) { n = k; }
};

int main() {
    Channel<Thing> c;
    return 0;
}
