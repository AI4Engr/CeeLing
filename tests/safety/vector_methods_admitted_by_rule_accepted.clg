//@ expect: accept
//@ run: 0 0 3 5 1
//@ reason: methods admitted by the rule over the scanned signatures (void or scalar results, no non-const
//@ reason: reference parameter): clear, empty, capacity-style readers, assign, shrink_to_fit.

int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    v.clear();
    std::cout << v.size() << " ";
    v.assign(3, 5);
    std::cout << v.empty() << " " << v.size() << " " << v[0] << " ";
    v.shrink_to_fit();
    std::cout << (v.capacity() >= 3) << std::endl;
    return 0;
}
