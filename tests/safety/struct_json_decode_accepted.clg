//@ expect: accept
//@ run: /tmp 1 3 2 2 5 y 2 0.5
//@ reason: `decodeArgs(item)` is never defined by the program: `Args` is a struct and a call to `decode<StructName>` asks the
//@ reason: compiler to generate the decoder (struct_json.h). Covers every field kind -- string, bool, a vector of int, a nested
//@ reason: struct, a vector of structs, a double -- and an extra key in the JSON (`ignored`), which is skipped. The generated code is
//@ reason: ordinary CeeLing and goes through the same checkers; this run proves the values arrive, not just that it compiles.

// ---- a stand-in for cjson-cling: just the names the generated decoders use ----
class Item {
public:
    Item next;
    Item child;
    string key;
    string valuestring;
    double valuedouble;
    int type;
    Item() { type = 0; valuedouble = 0.0; key = ""; valuestring = ""; }
};
bool isObject(Item i) { return i != nullptr && i.type == 6; }
bool isArray(Item i) { return i != nullptr && i.type == 5; }
bool isString(Item i) { return i != nullptr && i.type == 4; }
bool isNumber(Item i) { return i != nullptr && i.type == 3; }
bool isBool(Item i) { return i != nullptr && (i.type == 1 || i.type == 2); }
bool isTrue(Item i) { return i != nullptr && i.type == 2; }
int getArraySize(Item a) {
    int n = 0;
    Item c = a.child;
    while (c != nullptr) { n = n + 1; c = c.next; }
    return n;
}
Item getArrayItem(Item a, int index) {
    Item c = a.child;
    int k = index;
    while (c != nullptr && k > 0) { c = c.next; k = k - 1; }
    return c;
}
Item getObjectItem(Item o, string name) {
    Item c = o.child;
    while (c != nullptr) { if (c.key == name) { return c; } c = c.next; }
    return nullptr;
}
// ---- building a document by hand ----
Item node(int type, string key) { Item i = new Item(); i.type = type; i.key = key; return i; }
Item num(string key, double v) { Item i = new Item(); i.type = 3; i.key = key; i.valuedouble = v; return i; }
Item str(string key, string v) { Item i = new Item(); i.type = 4; i.key = key; i.valuestring = v; return i; }
Item flag(string key, bool v) { Item i = new Item(); i.key = key; i.type = 1; if (v) { i.type = 2; } return i; }
void put(Item parent, Item child) {
    if (parent.child == nullptr) { parent.child = child; return; }
    Item last = parent.child;
    while (last.next != nullptr) { last = last.next; }
    last.next = child;
}

struct Pt {
public:
    int x;
    int y;
    Pt(int a, int b) { x = a; y = b; }
};

struct Args {
public:
    string root;
    bool amend;
    std::vector<int> nums;
    Pt origin;
    std::vector<Pt> pts;
    double ratio;
    Args(string r, bool a, std::vector<int> n, Pt o, std::vector<Pt> p, double q) {
        root = r; amend = a; nums = n; origin = o; pts = p; ratio = q;
    }
};

int main() {
    Item doc = node(6, "");
    put(doc, str("root", "/tmp"));
    put(doc, str("ignored", "this key is not in Args"));
    put(doc, flag("amend", true));
    Item nums = node(5, "nums");
    put(nums, num("", 7.0));
    put(nums, num("", 8.0));
    put(nums, num("", 9.0));
    put(doc, nums);
    Item origin = node(6, "origin");
    put(origin, num("x", 1.0));
    put(origin, num("y", 2.0));
    put(doc, origin);
    Item pts = node(5, "pts");
    Item p1 = node(6, "");
    put(p1, num("x", 4.0));
    put(p1, num("y", 5.0));
    put(pts, p1);
    Item p2 = node(6, "");
    put(p2, num("x", 6.0));
    put(p2, num("y", 7.0));
    put(pts, p2);
    put(doc, pts);
    put(doc, num("ratio", 0.5));
    Args a = decodeArgs(doc);
    std::cout << a.root << " " << a.amend << " " << a.nums.size() << " " << a.origin.y << " " << a.pts.size() << " " << a.pts[0].y << " y " << a.nums.size() - 1 << " " << a.ratio << std::endl;
    return 0;
}
