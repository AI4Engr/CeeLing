//@ expect: reject
//@ reason: every name in a closure's capture list must resolve against the
//@ reason: enclosing scope at the closure's own source position -- a name
//@ reason: that was never declared (typo, or declared later/in an unrelated
//@ reason: scope) must be REJECTED, never silently ignored or defaulted to
//@ reason: some guessed type. This is the design notes' "ambiguous inference ->
//@ reason: conservative reject" rule applied to the one genuinely new lookup
//@ reason: this feature introduces (resolving a capture's declared type).

class Callback {
public:
    Callback() { }
    virtual void call(int x) { }
};

void each(Callback cb) {
    cb.call(1);
}

int main() {
    each(closure Callback [doesNotExist] (int x) {
        std::cout << x << std::endl;
    });
    return 0;
}
