//@ expect: reject
//@ reason: after `spawn` the object belongs to the new thread. Touching it here would be a data race, so the
//@ reason: ordinary use-after-move rule applies: any later use is refused.

class Buffer {
public:
    int n;
    Buffer() { n = 0; }
};

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    Buffer b = new Buffer();
    spawn(closure Job [b] () {
        b.n = 1;
    });
    b.n = 2;
    return 0;
}
