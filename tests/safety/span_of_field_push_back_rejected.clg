//@ expect: reject
//@ error: use of dangling observer `s` (the field `data` may have been changed)
//@ reason: push_back on the viewed field may reallocate it.

class Buffer {
public:
    std::vector<int> data;
    Buffer() {
        data.push_back(1);
    }
    int run() {
        std::span<int> s = data;
        data.push_back(2);
        return s[0];
    }
};

int main() {
    Buffer b = new Buffer();
    std::cout << b.run() << std::endl;
    return 0;
}
