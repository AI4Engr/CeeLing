//@ expect: reject
//@ error: use of moved-from value `v`
//@ reason: both calls take the vector by value, so the first one moves it and the second would read an emptied vector. Calls nested in an expression (here a sum)
//@ reason: used to be skipped by the move tracking, so this compiled and silently computed with an empty vector.

int total(std::vector<int> v) {
    v.push_back(1);
    return v.size();
}

int main() {
    std::vector<int> v;
    v.push_back(5);
    int a = total(v) + total(v);
    std::cout << a << std::endl;
    return 0;
}
