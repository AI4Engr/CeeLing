//@ expect: accept
//@ run: 10 1 3 3 11
//@ reason: a method views a vector FIELD of its own class. While the span lives the method does only reads, a heap-pure helper call and primitive writes, so nothing can resize the field.
//@ reason: A field is also accepted as the argument of a span parameter when the callee is heap-pure (sum() changes no container or field it does not own).

int sum(std::span<const int> s) {
    int t = 0;
    int i = 0;
    while (i < s.size()) {
        t = t + s[i];
        i = i + 1;
    }
    return t;
}

class Buffer {
public:
    std::vector<int> data;
    int hits;
    Buffer() {
        data.push_back(1);
        data.push_back(2);
        data.push_back(4);
        hits = 0;
    }
    int viaView() {
        std::span<int> s = data;
        s[0] = 5;
        hits = hits + 1;
        return s[0] + s.size() - 1 + sum(s) - 8;
    }
    int direct() {
        return sum(data);
    }
    int tail() {
        std::span<const int> s = data;
        std::span<const int> t = s.last(2);
        return t[0] + t.size() - 1;
    }
};

int main() {
    Buffer b = new Buffer();
    int a = b.viaView();
    std::cout << a << " " << b.hits << " " << b.data.size() << " " << b.tail() << " " << b.direct() << std::endl;
    return 0;
}
