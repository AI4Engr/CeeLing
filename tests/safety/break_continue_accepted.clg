//@ expect: accept
//@ run: 118
//@ reason: break leaves the innermost loop, continue skips to the next iteration; both in while and
//@ reason: in range-for. First loop adds 1+2+4+5+6 (3 skipped, stops at 7) = 18; second adds 100
//@ reason: for x=1 and stops at x=2.

int main() {
    int i = 0;
    int sum = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) { continue; }
        if (i == 7) { break; }
        sum = sum + i;
    }
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    v.push_back(3);
    for (int x : v) {
        if (x == 2) { break; }
        sum = sum + 100 * x;
    }
    std::cout << sum << std::endl;
    return 0;
}
