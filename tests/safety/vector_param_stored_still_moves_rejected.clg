//@ expect: reject
//@ reason: positive control -- a method that COPIES its vector<int>
//@ reason: parameter into a FIELD (escaping the call's scope into
//@ reason: longer-lived storage) is not read-only: the bare parameter as
//@ reason: an AssignmentStatement RHS disqualifies, the same way returning
//@ reason: it or reassigning it would. `v` is genuinely consumed by
//@ reason: cache.keep(v) and must reject after.

class Cache {
public:
    std::vector<int> kept;
    Cache() {
    }
    void keep(std::vector<int> data) {
        kept = data;
    }
};

int main() {
    std::vector<int> v;
    v.push_back(7);
    Cache cache = new Cache();
    cache.keep(v);
    std::cout << v[0] << std::endl;   // ERROR: v was moved into cache.keep(v)
    return 0;
}
