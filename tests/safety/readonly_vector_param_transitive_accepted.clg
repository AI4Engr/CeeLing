//@ expect: accept
//@ reason: a free function passing its vector<int> parameter BARE into
//@ reason: another already-read-only-container free function is itself
//@ reason: read-only (fixed-point classification, mirroring the object-typed
//@ reason: read-only rule's own transitive case) -- the caller's argument
//@ reason: survives both calls.
//@ run: 6 6 1 2 3

int sumAll(std::vector<int> data) {
    int total = 0;
    int i = 0;
    while (i < data.size()) {
        total = total + data[i];
        i = i + 1;
    }
    return total;
}

int sumTwice(std::vector<int> data) {
    return sumAll(data) + 0;
}

int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    v.push_back(3);
    int a = sumAll(v);
    int b = sumTwice(v);
    std::cout << a << " " << b << " " << v[0] << " " << v[1] << " " << v[2] << std::endl;
    return 0;
}
