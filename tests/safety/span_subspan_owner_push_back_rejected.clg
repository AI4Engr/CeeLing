//@ expect: reject
//@ error: use of dangling observer `t`
//@ reason: a span made from another span follows the same vector, so the vector growing kills it too.

int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    std::span<int> s = v;
    std::span<int> t = s.first(1);
    v.push_back(3);
    std::cout << t.size() << std::endl;
    return 0;
}
