//@ expect: reject
//@ error: `data` is not available on `std::span<int>`
//@ reason: data() would hand out a raw pointer; a span has no such method (nor begin/end), so nothing can escape through it.

int main() {
    std::vector<int> v;
    v.push_back(1);
    std::span<int> s = v;
    std::cout << s.data() << std::endl;
    return 0;
}
