//@ expect: accept
//@ run: 2 3
//@ reason: growing a DIFFERENT container inside the loop is fine, and so is walking a vector while the loop's own container is only read; the check is about the container being walked.
int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    std::vector<int> out;
    for (int x : v) {
        out.push_back(x * 10);
    }
    std::vector<int> more;
    more.push_back(7);
    for (int x : more) {
        v.push_back(x);
    }
    std::cout << out.size() << " " << v.size() << std::endl;
    return 0;
}
