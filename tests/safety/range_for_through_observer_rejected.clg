//@ expect: reject
//@ error: `r.push_back(...)` may reallocate `v` while the loop is walking it
//@ reason: `r` is a `ref` observer of `v`, so growing `r` grows `v`, the vector the loop is walking.
int main() {
    std::vector<int> v;
    v.push_back(1);
    ref std::vector<int> r = v;
    for (int x : v) {
        r.push_back(x);
    }
    return 0;
}
