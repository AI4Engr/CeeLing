//@ expect: reject
//@ error: use of dangling observer `s`
//@ reason: a read-only span follows its vector like any span: push_back may reallocate, so it dies.

int main() {
    std::vector<int> v;
    v.push_back(1);
    std::span<const int> s = v;
    v.push_back(2);
    std::cout << s.size() << std::endl;
    return 0;
}
