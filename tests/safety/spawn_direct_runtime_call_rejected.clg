//@ expect: reject
//@ reason: cling::spawn is the compiler's own lowering target for `spawn(closure ...)`. Calling it by hand
//@ reason: would skip the check on what is captured.

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    Job j = new Job();
    cling::spawn(j);
    return 0;
}
