//@ expect: accept
//@ reason: a captured std::vector of primitives is COPIED into the job, like a string, so the creating thread
//@ reason: keeps its own intact vector. Must be RUN: if the capture moved the vector instead, the source would
//@ reason: be empty here and print 0 -- a silent wrong answer a compile cannot see. (Only the creating thread
//@ reason: prints, so the output is deterministic.)
//@ run: 2

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    std::vector<int> data;
    data.push_back(1);
    data.push_back(2);
    spawn(closure Job [data] () {
        int total = 0;
        for (int x : data) {
            total = total + x;
        }
    });
    std::cout << data.size() << std::endl;
    return 0;
}
