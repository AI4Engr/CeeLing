//@ expect: accept
//@ run: 4 2 28 23 20 1 4
//@ reason: a span as a local and as a parameter, made from a vector variable and narrowed by subspan. A vector passed to a span parameter is viewed, not
//@ reason: moved (it is used again right after). A store through the span writes the vector's element.

int sum(std::span<int> s) {
    int total = 0;
    int i = 0;
    while (i < s.size()) {
        total = total + s[i];
        i = i + 1;
    }
    return total;
}

int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    v.push_back(3);
    v.push_back(4);
    std::span<int> s = v;
    std::span<int> mid = s.subspan(1, 2);
    mid[0] = 20;
    std::cout << s.size() << " " << mid.size() << " " << sum(v) << " " << sum(mid) << " " << v[1] << " " << s.front() << " " << s.back() << std::endl;
    return 0;
}
