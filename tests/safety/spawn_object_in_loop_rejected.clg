//@ expect: reject
//@ reason: spawning an object declared OUTSIDE a loop, inside the loop, would move it on the first iteration and
//@ reason: hand the second iteration a moved-from handle. Rejected by the same loop-carried move rule as any other
//@ reason: move out of a loop.

class Buffer {
public:
    int n;
    Buffer() { n = 0; }
};

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    Buffer b = new Buffer();
    int i = 0;
    while (i < 2) {
        spawn(closure Job [b] () {
            b.n = 1;
        });
        i = i + 1;
    }
    return 0;
}
