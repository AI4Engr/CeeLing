//@ expect: reject
//@ error: use of moved-from value `v`
//@ reason: the condition is evaluated again on every iteration, and its call moved v the first time.

int total(std::vector<int> v) {
    v.push_back(1);
    return v.size();
}

int main() {
    std::vector<int> v;
    v.push_back(5);
    int i = 0;
    while (total(v) > i) {
        i = i + 1;
        if (i > 3) {
            break;
        }
    }
    return 0;
}
