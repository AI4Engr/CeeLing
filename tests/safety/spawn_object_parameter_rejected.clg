//@ expect: reject
//@ reason: a parameter's dynamic type is unknown inside the function (the caller may pass any subclass or an
//@ reason: object it still holds elsewhere), so it cannot be moved into a thread.

class Buffer {
public:
    int n;
    Buffer() { n = 0; }
};

class Job {
public:
    Job() { }
    virtual void run() { }
};

void go(Buffer b) {
    spawn(closure Job [b] () {
        b.n = 1;
    });
}

int main() {
    Buffer b = new Buffer();
    go(b);
    return 0;
}
