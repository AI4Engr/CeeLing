//@ expect: reject
//@ reason: a closure naming an interface that isn't a declared class in this
//@ reason: program must be rejected, not silently accepted -- CeeLing cannot
//@ reason: desugar a closure into `class __closure_0 : public NoSuchThing`
//@ reason: when `NoSuchThing` doesn't exist (the generated C++ wouldn't even
//@ reason: parse). Matches the design notes' "default-reject, never default-allow":
//@ reason: an unknown interface gets the same treatment
//@ reason: validateInheritance already gives an unknown ordinary base class
//@ reason: (inherit_unknown_base_rejected.clg), just from
//@ reason: ASTBuilder::desugarClosures's own lookup instead.

class Callback {
public:
    Callback() { }
    virtual void call(int x) { }
};

void each(Callback cb) {
    cb.call(1);
}

int main() {
    int total = 100;
    each(closure NoSuchInterface [total] (int x) {
        std::cout << x << std::endl;
    });
    return 0;
}
