//@ expect: reject
//@ reason: v1 forbids a spawned job from spawning: no unbounded thread multiplication, and a second hop
//@ reason: the capture rule was not written for.

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    int n = 1;
    spawn(closure Job [n] () {
        int m = n;
        spawn(closure Job [m] () {
            std::cout << m << std::endl;
        });
    });
    return 0;
}
