//@ expect: reject
//@ reason: the default handler belongs to the thread that spawns. Registering one from inside a job body would
//@ reason: configure a worker thread's own spawns, which v1 forbids anyway (no spawn inside a spawn).

class Job {
public:
    Job() { }
    virtual void run() { }
};

class Failure {
public:
    Failure() { }
    virtual void fail(string message) { }
};

int main() {
    int id = 1;
    spawn(closure Job [id] () {
        int again = id;
        onJobFailure(closure Failure [again] (string message) {
            std::cout << message << std::endl;
        });
    });
    return 0;
}
