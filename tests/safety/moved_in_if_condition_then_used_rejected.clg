//@ expect: reject
//@ error: use of moved-from value `v`
//@ reason: a call in an if condition moves its argument as well.

int total(std::vector<int> v) {
    v.push_back(1);
    return v.size();
}

int main() {
    std::vector<int> v;
    v.push_back(5);
    if (total(v) > 0) {
        std::cout << "positive" << std::endl;
    }
    std::cout << v.size() << std::endl;
    return 0;
}
