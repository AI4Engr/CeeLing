//@ expect: accept
//@ run: built 999999
//@ reason: freeing a 1,000,000-node owning `next` chain. The implicit destructor of the generated C++
//@ reason: class recursed once per node and overflowed the stack (the program printed "built" and
//@ reason: then crashed at scope exit, exit code 127 on this toolchain); CeeLing now generates an
//@ reason: iterative destructor for a class with an owning field of its own type.

class Item {
public:
    Item next;
    int v;
    Item(int x) { v = x; }
};

int main() {
    Item head = new Item(0);
    int i = 1;
    while (i < 1000000) {
        Item n = new Item(i);
        n.next = head;
        head = n;
        i = i + 1;
    }
    std::cout << "built " << head.v << std::endl;
    return 0;
}
