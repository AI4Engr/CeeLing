//@ expect: reject
//@ error: `v.clear(...)` may reallocate `v` while the loop is walking it
//@ reason: `clear` is on the list of calls that reshape a vector; the loop's iterators are invalid after it, even if this body only runs once.
int main() {
    std::vector<int> v;
    v.push_back(1);
    v.push_back(2);
    for (int x : v) {
        v.clear();
        std::cout << x << std::endl;
    }
    return 0;
}
