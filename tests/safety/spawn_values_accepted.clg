//@ expect: accept
//@ reason: the thread rule's positive case. A spawned job may capture only plain values -- primitives, string
//@ reason: and std::vector of primitives -- because those are COPIED into the job, so nothing the new thread
//@ reason: can reach is reachable from the creating thread. Must be RUN: the job executes on another thread
//@ reason: and the process must join it before exiting (otherwise the output would be lost or the run would
//@ reason: abort), which no -fsyntax-only compile can tell.
//@ run: job 7 hello 3
//
// Only one worker thread prints, so the output is deterministic.

class Job {
public:
    Job() { }
    virtual void run() { }
};

int main() {
    int n = 7;
    string word = "hello";
    std::vector<int> data;
    data.push_back(1);
    data.push_back(2);
    data.push_back(3);
    spawn(closure Job [n, word, data] () {
        int total = 0;
        for (int x : data) {
            total = total + x;
        }
        std::cout << "job " << n << " " << word << " " << (total / 2) << std::endl;
    });
    return 0;
}
