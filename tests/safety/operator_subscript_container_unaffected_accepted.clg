//@ reason: container).
//@ run: 10 two

class Box {
public:
    int val;
    Box(int v) { val = v; }
    int operator[](string key) {
        return val;
    }
};

int main() {
    std::vector<int> v;
    v.push_back(10);
    int first = v[0];

    std::map<int, string> m;
    m[1] = "one";
    m[2] = "two";
    string second = m[2];

    Box b = new Box(999);
    int unused = b["k"];

    std::cout << first << " " << second << std::endl;
    return 0;
}
