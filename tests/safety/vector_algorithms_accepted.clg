//@ expect: accept
//@ run: 2259 92 2 -1 10 774 -1 apple 4
//@ reason: CeeLing's own whole-vector methods on vectors of primitives (no iterators): sort, reverse, fill, indexOf (-1 when absent), contains. A vector of strings sorts too.
//@ reason: A span of the vector survives them (none changes size or reallocates): the last value is the span's size after sorting.

int main() {
    std::vector<int> v;
    v.push_back(5);
    v.push_back(2);
    v.push_back(9);
    v.push_back(2);
    std::span<int> s = v;
    v.sort();
    std::cout << v[0] << v[1] << v[2] << v[3] << " ";
    v.reverse();
    std::cout << v[0] << v[3] << " " << v.indexOf(2) << " " << v.indexOf(7) << " " << v.contains(9) << v.contains(4) << " ";
    v.fill(7);
    std::cout << v[0] << v[3] << v.size() << " ";
    std::vector<double> d;
    d.push_back(2.5);
    d.push_back(-1.0);
    d.sort();
    std::vector<string> w;
    w.push_back("pear");
    w.push_back("apple");
    w.sort();
    std::cout << d[0] << " " << w[0] << " " << s.size() << std::endl;
    return 0;
}
