//@ expect: reject
//@ error: use of dangling observer `s`
//@ reason: the vector is declared in an inner block and dies at its end; the span declared outside it would then point at freed memory.

int main() {
    std::vector<int> w;
    w.push_back(0);
    std::span<int> s = w;
    if (w.size() > 0) {
        std::vector<int> v;
        v.push_back(1);
        s = v;
    }
    std::cout << s.size() << std::endl;
    return 0;
}
