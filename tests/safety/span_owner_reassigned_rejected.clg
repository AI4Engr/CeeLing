//@ expect: reject
//@ error: use of dangling observer `s`
//@ reason: reassigning the vector replaces its buffer, so a span of it is dead.

int main() {
    std::vector<int> v;
    v.push_back(1);
    std::vector<int> other;
    other.push_back(7);
    std::span<int> s = v;
    v = other;
    std::cout << s.size() << std::endl;
    return 0;
}
