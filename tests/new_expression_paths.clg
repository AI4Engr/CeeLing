#include <iostream>

class Node {
public:
    int data;
    Node next;

    Node cloneWith(int value) {
        return new Node(value);
    }

    void attach(Node child) {
        next = child;
    }

    Node(int value) {
        data = value;
        next = nullptr;
    }
};

int main() {
    Node head = new Node(1);
    head.next = new Node(2);
    head.attach(new Node(3));
    return 0;
}
