//@ expect: reject
//@ legacy: uses owned<>/borrowed<> scaffolding syntax; superseded by tests/safety/*.clg
// B1b negative fixture: storing a borrow in a field lets it escape the call that created it
// and outlive its owner. Here `Holder.ref` keeps a borrow of `a`; after `a` is moved into
// `eat`, reading through `h.ref` would dereference freed memory. CeeLing must reject the
// borrow-typed field itself at compile time (`error[semantic/borrow_field]`), before any of
// this can run.
#include <memory>
#include <iostream>

class Node {
public:
    int v;
    Node(int x) { v = x; }
};

class Holder {
public:
    borrowed<Node> ref;

    void keep(borrowed<Node> n) {
        ref = n;
    }

    int read() {
        return ref.v;
    }
};

void eat(owned<Node> n) {
}

int main() {
    owned<Node> a = new Node(555);
    Holder h = new Holder();
    h.keep(a);
    eat(a);
    std::cout << h.read() << "\n";
    return 0;
}
