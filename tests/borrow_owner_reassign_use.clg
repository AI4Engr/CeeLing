//@ expect: reject
//@ legacy: uses owned<>/borrowed<> scaffolding syntax; superseded by tests/safety/*.clg
// B1 negative fixture (scenario A): a borrow of an owner, then the owner is reassigned to a
// fresh object (freeing the old one), then the borrow is used. The old object the borrow
// points at is gone — CeeLing must reject this at compile time.
#include <memory>

class Node {
public:
    int v;
    Node(int x) { v = x; }
};

int main() {
    owned<Node> a = new Node(1);
    borrowed<Node> b = a;
    a = new Node(2);
    std::cout << b.v << std::endl;
    return 0;
}
