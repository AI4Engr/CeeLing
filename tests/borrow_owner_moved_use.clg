//@ expect: reject
//@ legacy: uses owned<>/borrowed<> scaffolding syntax; superseded by tests/safety/*.clg
// B1 negative fixture (scenario B): a borrow of an owner, then the owner is moved away
// (consumed by an `owned<T>` sink), then the borrow is used. The borrowed object no longer
// has a live owner, so `b.v` dangles — CeeLing must reject this at compile time.
#include <memory>

class Node {
public:
    int v;
    Node(int x) { v = x; }
};

void sink(owned<Node> n) {
}

int main() {
    owned<Node> a = new Node(1);
    borrowed<Node> b = a;
    sink(a);
    print(b.v);
    return 0;
}
