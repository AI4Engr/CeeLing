# CeeLing Source Mapping for GDB (Manual Mode)
# This script helps map generated C++ code back to original .clg source

# Disable all interactive features that can cause stdin issues
set pagination off
set height 0
set width 0
set confirm off
set verbose off
set complaints 0

# Disable history to avoid file I/O issues
set history save off

# Define source mapping function
define ceeling-map-source
    # Map generated C++ lines back to .clg source
    set substitute-path example.cpp ../example.clg
    directory ..
end

# Auto-load source mapping
ceeling-map-source

# Set up pretty printing for smart pointers
set print pretty on

# Welcome message
echo === CeeLing GDB Manual Debug Mode ===\n
echo Source mapping enabled: example.cpp -> ../example.clg\n
echo Use standard GDB commands:\n
echo   break main        - Set breakpoint at main\n
echo   run              - Start the program\n
echo   next/step        - Step through code\n
echo   print <var>      - Print variable value\n
echo   info locals      - Show all local variables\n
echo   list             - Show current source\n
echo   quit             - Exit GDB\n
echo =====================================\n
