// Basic Function Example
#include <iostream>
#include <memory>

int a = 1;
int b = 15;

class Node {
public:
    int data;
    Node next;
    Node(int value) {
        data = value;
        next = nullptr;
    }
};

int main() {
    Node node = new Node(10);
    int a = 1;
    std::cout << "Node created with data: " << node->data << std::endl;
    return 0;
}