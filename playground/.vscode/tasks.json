{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure-cmake",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}/playground",
                "-B", "${workspaceFolder}/playground/build",
                "-G", "Ninja"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "build-cling-program",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/playground/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "configure-cmake",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run-cling-program",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/playground/build",
                "--target", "run"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "dependsOn": "build-cling-program",
            "problemMatcher": []
        },
        {
            "label": "clean-rebuild",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/playground/build",
                "--target", "rebuild"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}