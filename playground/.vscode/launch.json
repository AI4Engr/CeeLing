{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CeeLing Program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/playground/build/example.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/playground/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassembly-flavor to intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "${workspaceFolder}/playground/build/example.cpp": "${workspaceFolder}/example.clg"
            },
            "preLaunchTask": "build-ceeling-program"
        }
    ]
}