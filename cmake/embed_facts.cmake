# Embeds facts/*.clfacts into the compiler so cling.exe stays a single file (no data directory to find at run time).
# Writes ${OUT} (a .cpp) defining cling::kBuiltinPacks / cling::kBuiltinPackCount. Byte arrays avoid string-literal
# length limits (MSVC) and any quoting problem. Re-run automatically when a pack changes (CMAKE_CONFIGURE_DEPENDS).
function(cling_embed_facts OUT FACT_DIR)
    file(GLOB PACKS "${FACT_DIR}/*.clfacts")
    list(SORT PACKS)
    set(BODY "// GENERATED by cmake/embed_facts.cmake from facts/*.clfacts. Do not edit.\nnamespace cling {\nstruct BuiltinPackText { const char* name; const unsigned char* data; unsigned long size; };\n")
    set(TABLE "")
    set(N 0)
    foreach(P ${PACKS})
        get_filename_component(NAME "${P}" NAME)
        file(READ "${P}" HEXDATA HEX)
        string(LENGTH "${HEXDATA}" HEXLEN)
        math(EXPR BYTES "${HEXLEN} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," ARRAY "${HEXDATA}")
        string(APPEND BODY "static const unsigned char pack${N}[] = {${ARRAY}0};\n")
        string(APPEND TABLE "    {\"${NAME}\", pack${N}, ${BYTES}UL},\n")
        math(EXPR N "${N} + 1")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${P}")
    endforeach()
    string(APPEND BODY "extern const BuiltinPackText kBuiltinPacks[] = {\n${TABLE}    {\"\", 0, 0}\n};\nextern const unsigned long kBuiltinPackCount = ${N}UL;\n}  // namespace cling\n")
    file(WRITE "${OUT}.tmp" "${BODY}")
    execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
endfunction()
